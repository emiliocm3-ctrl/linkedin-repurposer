// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Subscription info
  stripeCustomerId     String?   @unique
  subscriptionTier     String    @default("free") // free, starter, professional, agency
  subscriptionStatus   String?   // active, canceled, past_due, trialing
  subscriptionId       String?   @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?

  // Usage tracking
  conversionsUsed  Int      @default(0)
  conversionsLimit Int      @default(5) // Reset monthly based on tier
  lastResetDate    DateTime @default(now())

  // Referral tracking
  referralCode String?  @unique
  referredBy   String?
  referralCredits Int   @default(0)

  conversions Conversion[]

  @@index([email])
  @@index([clerkId])
  @@index([stripeCustomerId])
}

model Conversion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Input
  originalContent String @db.Text
  sourceUrl       String?

  // Outputs (generated by AI)
  twitterThread String? @db.Text
  blogPost      String? @db.Text
  newsletter    String? @db.Text

  // Metadata for customization
  tone     String? // professional, casual, witty
  industry String? // tech, marketing, finance, sales, general

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model ReferralReward {
  id String @id @default(cuid())

  referrerId String
  refereeId  String

  rewardType   String // free_month, discount, credits
  rewardAmount Int    @default(1) // 1 month, 1 credit, etc.
  claimed      Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([referrerId])
  @@index([refereeId])
}
